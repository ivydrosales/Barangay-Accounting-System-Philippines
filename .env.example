# Copy to .env.local for local development. On Vercel, add the same two
# variables under Project > Settings > Environment Variables.
#
# Both come from the Supabase dashboard: Project Settings > API.
# The second is the public "anon" key (some dashboards call it "publishable").
# It is safe in the browser because row-level security decides what it can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
